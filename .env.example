# Luma Memory Module Configuration Template
# Copy this file to .env and update values as needed

# ============================================================================
# Storage Settings
# ============================================================================

# Path to SQLite database file
DB_PATH=./data/luma_memory.db

# Number of entries to cache in memory (LRU cache)
CACHE_SIZE=1000

# Maximum storage size in megabytes before warning
MAX_STORAGE_SIZE_MB=1000

# ============================================================================
# Summarization Settings
# ============================================================================

# Number of entries before triggering summarization
SUMMARIZATION_THRESHOLD=1000

# Similarity threshold for identifying redundant entries (0.0 - 1.0)
SIMILARITY_THRESHOLD=0.8

# Number of days to retain raw entries before summarization
RETENTION_DAYS_RAW=30

# Number of days to retain summarized entries
RETENTION_DAYS_SUMMARY=365

# ============================================================================
# Encryption Settings
# ============================================================================

# Path to encryption key file (will be generated if not exists)
ENCRYPTION_KEY_PATH=./keys/encryption.key

# ============================================================================
# API Settings
# ============================================================================

# API server host address
API_HOST=0.0.0.0

# API server port
API_PORT=8000

# Number of API worker processes
API_WORKERS=4

# ============================================================================
# Performance Settings
# ============================================================================

# Query timeout in milliseconds
QUERY_TIMEOUT_MS=200

# Database connection pool size
CONNECTION_POOL_SIZE=10

# ============================================================================
# Monitoring Settings
# ============================================================================

# Enable metrics collection (true/false)
ENABLE_METRICS=true

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Logging format (json for structured JSON, human for readable)
LOG_FORMAT=human

# Optional path to log file for persistent logging (leave empty for console only)
# LOG_FILE=./logs/luma_memory.log

# Maximum size of log file before rotation in bytes (default: 10MB)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep (default: 5)
LOG_BACKUP_COUNT=5

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# LLM provider selection (gemini, mock, or future providers)
# Default: gemini
LLM_PROVIDER=gemini

# Gemini API configuration (required when LLM_PROVIDER=gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Request timeout in seconds (default: 30.0)
GEMINI_TIMEOUT=30.0

# Maximum tokens to generate (default: 1024)
GEMINI_MAX_TOKENS=1024

# Temperature for generation (0.0-1.0, default: 0.4)
GEMINI_TEMPERATURE=0.4

# Enable full prompt logging for debugging (true/false, default: false)
# WARNING: Enabling this may log sensitive prompt data
GEMINI_LOG_PROMPTS=false

# Existing LLM configuration (still used for fallback behavior)
LLM_MAX_RETRIES=3
LLM_MAX_RESPONSE_CHARS=4000
LLM_FALLBACK_RESPONSE="I'm having trouble generating a response right now."
