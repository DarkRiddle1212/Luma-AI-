# Luma AI System - Production Configuration Example
# Copy this file to .env for production deployment
# IMPORTANT: Never commit .env files with real secrets to version control

# ============================================================================
# ENVIRONMENT
# ============================================================================

# Environment name (development, staging, production)
ENVIRONMENT=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# SQLite database file path
# Use absolute path in production for clarity
# Ensure the directory exists and has proper permissions (700)
DATABASE_URL=sqlite:////home/luma/luma-app/data/luma.db

# Alternative: PostgreSQL (for future migration)
# DATABASE_URL=postgresql://username:password@localhost:5432/luma_db

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API host (use 127.0.0.1 for localhost-only access with reverse proxy)
# Use 0.0.0.0 only if exposing directly (not recommended)
API_HOST=127.0.0.1

# API port (default: 8000)
# Should not be exposed directly - use reverse proxy (Nginx/Caddy)
API_PORT=8000

# API route prefix
API_PREFIX=/api/v1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Use INFO or WARNING in production to reduce log volume
LOG_LEVEL=INFO

# Optional: Log file path for persistent logging
# If not set, logs go to stdout (captured by systemd/Docker)
# LOG_FILE=/home/luma/luma-app/logs/luma.log

# Optional: Log rotation settings
# LOG_MAX_BYTES=10485760  # 10MB
# LOG_BACKUP_COUNT=5

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# API Key for authentication (implement middleware first)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=your-secure-api-key-here

# Allowed CORS origins (comma-separated)
# Default: * (allow all) - CHANGE THIS IN PRODUCTION
# CORS_ORIGINS=https://your-frontend.com,https://app.your-domain.com

# Secret key for session management (if implementing sessions)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-secret-key-here

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================

# Number of Uvicorn worker processes
# Recommended: (2 x CPU cores) + 1
# For single-user system: 2-4 workers is sufficient
WORKERS=4

# Request timeout in seconds
# REQUEST_TIMEOUT=60

# Maximum request body size in bytes (default: 100MB)
# MAX_REQUEST_SIZE=104857600

# ============================================================================
# DATABASE OPTIMIZATION (SQLite)
# ============================================================================

# SQLite connection pool size (for future use with connection pooling)
# DB_POOL_SIZE=5

# SQLite timeout in seconds
# DB_TIMEOUT=30

# Enable SQLite WAL mode for better concurrency (recommended)
# DB_WAL_MODE=true

# ============================================================================
# MONITORING AND METRICS
# ============================================================================

# Enable metrics collection (true/false)
# ENABLE_METRICS=true

# Metrics export port (for Prometheus scraping)
# METRICS_PORT=9090

# Health check interval in seconds
# HEALTH_CHECK_INTERVAL=30

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Automatic backup enabled (true/false)
# BACKUP_ENABLED=true

# Backup directory path
# BACKUP_DIR=/home/luma/luma-app/backups

# Backup retention days
# BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# ============================================================================
# RATE LIMITING
# ============================================================================

# Enable rate limiting (true/false)
# RATE_LIMIT_ENABLED=true

# Requests per minute per IP/API key
# RATE_LIMIT_PER_MINUTE=100

# Burst allowance
# RATE_LIMIT_BURST=20

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable API documentation endpoints (/docs, /redoc)
# Disable in production for security
ENABLE_DOCS=false

# Enable debug mode (NEVER enable in production)
DEBUG=false

# Enable detailed error messages in API responses
# Disable in production to avoid information disclosure
DETAILED_ERRORS=false

# ============================================================================
# EXTERNAL SERVICES (Future)
# ============================================================================

# Redis URL (for caching, sessions, rate limiting)
# REDIS_URL=redis://localhost:6379/0

# Email service (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com

# ============================================================================
# NOTES
# ============================================================================

# 1. File Permissions:
#    - This file should have 600 permissions (read/write for owner only)
#    - Command: chmod 600 .env
#
# 2. Secret Generation:
#    - Use cryptographically secure random values for secrets
#    - Never reuse secrets across environments
#    - Rotate secrets regularly
#
# 3. Database Path:
#    - Ensure database directory exists: mkdir -p /home/luma/luma-app/data
#    - Set proper permissions: chmod 700 /home/luma/luma-app/data
#    - Database file should be 600: chmod 600 /home/luma/luma-app/data/luma.db
#
# 4. Reverse Proxy:
#    - Always use Nginx/Caddy in production
#    - Let reverse proxy handle HTTPS/TLS
#    - Application should listen on 127.0.0.1 only
#
# 5. Monitoring:
#    - Monitor logs: journalctl -u luma -f
#    - Monitor resources: htop, df -h
#    - Set up alerts for errors and resource exhaustion
#
# 6. Backups:
#    - Implement regular database backups (see BACKUP_STRATEGY.md)
#    - Test backup restoration regularly
#    - Store backups securely off-site
#
# 7. Updates:
#    - Keep dependencies updated for security patches
#    - Test updates in staging before production
#    - Have rollback plan ready

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================

# Before deploying to production, verify:
# [ ] All secrets are unique and secure (not defaults)
# [ ] DEBUG=false
# [ ] ENABLE_DOCS=false (or protected by authentication)
# [ ] LOG_LEVEL=INFO or WARNING
# [ ] API_HOST=127.0.0.1 (with reverse proxy)
# [ ] CORS_ORIGINS restricted to trusted domains
# [ ] Database file permissions are 600
# [ ] Application runs as non-root user
# [ ] HTTPS/TLS configured on reverse proxy
# [ ] Firewall rules configured
# [ ] Backup strategy implemented
# [ ] Monitoring and alerting set up
# [ ] Security review completed (see docs/SECURITY.md)
